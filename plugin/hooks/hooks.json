{
  "description": "Notices when the docs wiki has drifted from the code. Silent when clean.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/docs-notice.py\""
          }
        ]
      }
    ]
  }
}
